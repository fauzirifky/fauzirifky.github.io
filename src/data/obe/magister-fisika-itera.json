  },
  "outcomes": [
    {
      "id": "CPL-1",
      "code": "CPL 1",
      "label": "Mampu menganalisis konsep-konsep dasar, lanjutan, dan terapan dalam fisika."
    },
    {
      "id": "CPL-2",
      "code": "CPL 2",
      "label": "Mampu melaksanakan dan menganalisis penelitian dalam bidang fisika dengan menggunakan metode ilmiah yang tepat."
    },
    {
      "id": "CPL-3",
      "code": "CPL 3",
      "label": "Mampu mengoptimalkan penggunaan teknologi dan peralatan laboratorium untuk mendukung eksperimen dan penelitian di bidang fisika."
    },
    {
      "id": "CPL-4",
      "code": "CPL 4",
      "label": "Mampu menyampaikan dan menyimpulkan hasil penelitian dan kajian ilmiah secara efektif dalam bentuk tulisan maupun presentasi lisan."
    },
    {
      "id": "CPL-5",
      "code": "CPL 5",
      "label": "Mampu mengembangkan inovasi dan solusi kreatif dalam menghadapi tantangan dan permasalahan kompleks di bidang fisika dan aplikasinya."
    },
    {
      "id": "CPL-6",
      "code": "CPL 6",
      "label": "Mampu merencanakan penelitian dan aplikasinya di masyarakat dengan menunjukkan profesionalisme, etika akademik, dan tanggung jawab."
    },
    {
      "id": "CPL-7",
      "code": "CPL 7",
      "label": "Mampu mengorganisasikan tim dan menunjukkan kemampuan kepemimpinan melalui pendekatan inter maupun multidisiplin."
    },
    {
      "id": "CPL-8",
      "code": "CPL 8",
      "label": "Mampu mengembangkan diri dan mengikuti perkembangan ilmu pengetahuan dan teknologi terbaru dalam bidang fisika secara mandiri dan berkelanjutan."
    },
    {
      "id": "CPL-9",
      "code": "CPL 9",
      "label": "Mampu mengembangkan pengetahuan dan keterampilan di bidang fisika untuk berkontribusi pada sains, teknologi, industri, dan kesejahteraan masyarakat."
    }
  ],
